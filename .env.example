# Example Environment Configuration
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file or hardcode credentials into Python scripts.

# Financial Data API Keys (e.g., Financial Modeling Prep, Alpha Vantage, SEC EDGAR User-Agent)
SEC_EDGAR_USER_AGENT="YourName user@domain.com"
FINANCIAL_API_KEY="your_api_key_here"

# Database Connection Credentials (if applicable)
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="corporate_financial_health"
DB_USER="postgres"
DB_PASSWORD="your_secure_password"
